PORT=3000
HOST=0.0.0.0
DB_PATH=./data/autopilot.db
PUBLIC_URL=https://autopilot.example.com
# Set both when serving over HTTPS behind a reverse proxy
SECURE_COOKIES=true
TRUST_PROXY=true
SESSION_TTL_HOURS=336
WORKER_CONCURRENCY=4
# Email delivery: "log" (outbox only) or "webhook" (POST JSON to your provider/relay)
EMAIL_PROVIDER=log
EMAIL_WEBHOOK_URL=
EMAIL_FROM=autopilot@example.com
# Allow the HTTP action to reach private/internal addresses (off by default for SSRF safety)
ALLOW_PRIVATE_NETWORK_REQUESTS=false
RUN_RETENTION_DAYS=90
